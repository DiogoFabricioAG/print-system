---
import Layout from '../layouts/Layout.astro';
import { Topbar } from '../components/dashboard/Topbar';
import { SellsView } from '../components/sells/SellsView';
---

<Layout title="Ventas | Print System" showSidebar={false} wideContent>
  <div class="w-full space-y-6 py-8 md:space-y-8">
    
    {/* Header / Topbar */}
    <Topbar inHomePage={false} client:load />

    {/* Vista Principal de Ventas */}
    <div class="mt-8">
      <SellsView client:load />
    </div>

  </div>
</Layout>
