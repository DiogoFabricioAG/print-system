---
import Layout from '../layouts/Layout.astro';
import { Topbar } from '../components/dashboard/Topbar';
import { NavigationPanel } from '../components/dashboard/NavigationPanel';
import { EstadosFinancieros } from '../components/dashboard/EstadoResultados';
import { DashboardCharts } from '../components/dashboard/DashboardCharts';
---

<Layout title="Dashboard Comercial" showSidebar={false}>
  <div class="space-y-6 md:space-y-8 max-w-7xl mx-auto py-8">
    <Topbar client:load />

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 md:gap-8">
      <div class="lg:col-span-4 xl:col-span-3 flex flex-col gap-4">
        <NavigationPanel client:load />
        
        {/* Atención por WhatsApp */}
        <a
          href="https://wa.me/message/ZR4KQO67FJRZD1"
          target="_blank"
          rel="noopener noreferrer"
          class="flex-1 cursor-pointer group relative overflow-hidden rounded-2xl bg-white border border-slate-200 hover:border-sky-500 transition-colors hover:shadow-md flex items-center justify-center"
        >
          <div class="flex  flex-col items-center gap-3 p-6 text-center">
            <div class="relative shrink-0">
              <div class="w-12 h-12 rounded-xl bg-sky-700 flex items-center justify-center">
                <svg class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/><line x1="9" y1="10" x2="15" y2="10"/></svg>
              </div>
            </div>
            <div>
              <p class="text-base font-bold text-indigo-900">Atención por WhatsApp</p>
              <p class="text-sm text-indigo-700 mt-1 leading-relaxed max-w-[200px]">
                Escríbenos para consultar ventas, clientes, deudas y más.
              </p>
            </div>
          </div>
        </a>

      </div>
      
      <div class="lg:col-span-8 xl:col-span-9 flex flex-col min-h-[220px]" id="estado-resultados">
        <EstadosFinancieros client:load />
      </div>

    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 md:gap-8">
      <div class="lg:col-span-12 flex flex-col min-h-[400px]">
        <DashboardCharts 
          client:load 
        />
      </div>
    </div>
  </div>
</Layout>
