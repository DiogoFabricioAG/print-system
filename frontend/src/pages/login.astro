---
import Layout from '../layouts/Layout.astro';
import { Card, CardContent, CardHeader, CardTitle, CardDescription } from "@/components/ui/card";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { Button } from "@/components/ui/button";
---

<Layout title="Iniciar Sesión" showSidebar={false}>
  <div class="fixed inset-0 flex items-center justify-center overflow-y-auto px-4 py-6">
    <div class="w-full max-w-sm">
      <Card className="border-slate-200 shadow-lg bg-white">
        <CardHeader className="text-center pb-3">
          <CardTitle className="text-xl font-bold text-slate-900">Bienvenido</CardTitle>
          <CardDescription className="text-slate-500 text-sm">Ingresa tus credenciales</CardDescription>
        </CardHeader>
        <CardContent className="pt-2 pb-6">
          <form id="login-form" class="space-y-4">
            <div class="space-y-2">
              <Label htmlFor="username" className="text-slate-700 text-sm font-medium">Usuario</Label>
              <Input 
                id="username" 
                type="text" 
                placeholder="Usuario" 
                autoComplete="username"
                required 
                className="h-12 rounded-xl border-slate-200 focus-visible:ring-[#30b7ff] text-base"
              />
            </div>

            <div class="space-y-2">
              <Label htmlFor="password" className="text-slate-700 text-sm font-medium">Contraseña</Label>
              <Input 
                id="password" 
                type="password" 
                placeholder="••••••••" 
                autoComplete="current-password"
                required 
                className="h-12 rounded-xl border-slate-200 focus-visible:ring-[#30b7ff] text-base"
              />
            </div>

            <p id="error-msg" class="text-xs text-red-500 hidden"></p>

            <Button 
              type="submit" 
              className="w-full h-12 rounded-xl bg-sky-700 hover:bg-sky-800 text-white text-sm font-semibold"
            >
              Ingresar
            </Button>
          </form>
          <a href="https://task-system.diogoabregu.tech/login" class="mt-5 block text-center text-sm font-medium text-sky-700 underline underline-offset-4">Acceso al sistema de trabajos</a>
        </CardContent>
      </Card>
    </div>
  </div>

  <script>
    import { authApi } from '@/lib/api';
    import { setUser } from '@/lib/auth';

    const form = document.getElementById('login-form') as HTMLFormElement;
    const errorMsg = document.getElementById('error-msg');
    const submitBtn = form.querySelector('button[type="submit"]');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const username = (document.getElementById('username') as HTMLInputElement).value;
      const password = (document.getElementById('password') as HTMLInputElement).value;
      
      // Disable button and show loading
      if (submitBtn) {
        submitBtn.textContent = 'Ingresando...';
        (submitBtn as HTMLButtonElement).disabled = true;
      }
      
      try {
        const user = await authApi.login(username, password);
        setUser(user);
        window.location.href = '/';
      } catch (error: any) {
        if (errorMsg) {
          errorMsg.textContent = error.message || 'Usuario o contraseña incorrectos';
          errorMsg.classList.remove('hidden');
        }
        if (submitBtn) {
          submitBtn.textContent = 'Ingresar';
          (submitBtn as HTMLButtonElement).disabled = false;
        }
      }
    });
  </script>
</Layout>
