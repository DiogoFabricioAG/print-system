# Carpeta raíz del watcher. Se crean automáticamente:
#   entrada/      → deja aquí los PNG (o llegan por otro proceso)
#   procesados/   → ventas registradas con éxito
#   rechazados/   → archivos inválidos o ignorados (con .motivo.txt)
#   pendientes/   → casos que requieren revisión manual
#   logs/         → watcher.log
WATCH_ROOT=C:\PrintSystem\ventas

# Carpeta monitoreada (OPCIONAL). Si no se define, se usa <WATCH_ROOT>\entrada.
# Útil si los PNG llegan a otra ruta (otro disco, carpeta de red, etc.):
# WATCH_FOLDER=D:\Disenos\cola

# API de Print System y API key (la generas con `npm run api-key` en functions/)
API_URL=https://functions.diogofabricio17.workers.dev/api
API_KEY=pega-tu-api-key-aqui

# ── Opcionales ───────────────────────────────────────────────────────────────
# Interfaz gráfica (Tkinter) para resolver clientes/nombres dudosos.
# GUI_ENABLED=true

# Separador entre campos (por defecto " - "): DISEÑO - CLIENTE - CANTIDAD - METRAJE - PAGO - MAQUINA.png
# SEPARATOR=" - "

# El diálogo abre con Debe seleccionado; también permite Pagó o Crédito.

# Reintentos ante errores de red/5xx (backoff exponencial).
# MAX_RETRIES=5
# RETRY_BASE_SECONDS=5
# RETRY_MAX_SECONDS=300

# Espera de estabilidad del archivo (evita procesar copias a medias).
# STABILITY_CHECKS=2
# STABILITY_INTERVAL=0.5
# STABILITY_TIMEOUT=30

# Pulso escrito por el watcher; el supervisor comprueba que se actualice.
# HEARTBEAT_INTERVAL_SECONDS=30

# Supervisor de Windows: intervalo configurable al instalar install-heartbeat.ps1.

# Alias extra de máquina: clave=valor separados por coma.
# MAQUINA_ALIASES=serigrafia=Serigrafía,vinilo=vinil
